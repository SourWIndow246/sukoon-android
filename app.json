{
  "expo": {
    "name": "Sukoon",
    "slug": "sukoon",
    "scheme": "sukoon",
    "version": "1.0.6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F6E56"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.sukoon.health"
    },
    "android": {
      "package": "in.sukoon.health",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F6E56"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Sukoon · A little care. A lot of calm."
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose medical records to add to your health history.",
          "cameraPermission": "Scan your medical records.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your approximate area for weather context and nearby care."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Sukoon to listen while voice chat is on.",
          "speechRecognitionPermission": "Allow Sukoon to turn your voice messages into text.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}

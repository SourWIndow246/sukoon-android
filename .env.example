# Public app configuration. Leave empty for the clearly labelled local demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Backend only. NEVER prefix a secret with EXPO_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative provider (set AI_PROVIDER=anthropic to use it).
ANTHROPIC_API_KEY=
# Choose an available model for your Anthropic account (the requested Sonnet 4 is retired).
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3001
ALLOWED_ORIGIN=http://localhost:8081
REVENUECAT_WEBHOOK_SECRET=
FINANCE_PARTNER_URL=
